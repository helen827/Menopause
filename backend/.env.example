APP_PORT=8888
APP_HOST=127.0.0.1
DEBUG=true
COOKIE_SECRET=dev-cookie-secret-change-me
# 本地 HTTP 调试时可设为 false；生产 HTTPS 建议不设置或设为 true。
# COOKIE_SECURE=false

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=menopause_xia
MYSQL_POOL_MIN_SIZE=1
MYSQL_POOL_MAX_SIZE=5

# 阿里云凭据由 alibabacloud_credentials 读取，常用环境变量如下：
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_DYPNS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_SMS_COUNTRY_CODE=86
ALIYUN_SMS_SCHEME_NAME=menocalm_sms
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_TEMPLATE_PARAM={"code":"##code##","min":"5"}
ALIYUN_SMS_CODE_LENGTH=6
ALIYUN_SMS_CODE_TYPE=1
ALIYUN_SMS_VALID_TIME=300
ALIYUN_SMS_INTERVAL=60
ALIYUN_SMS_RETURN_VERIFY_CODE=false
ALIYUN_SMS_MOCK=false

DEEPSEEK_API_KEY=你的DeepSeekKey
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_HISTORY=40
DEEPSEEK_MAX_TOKENS=1200

# 反恶意使用保护：限流、登录爆破保护、聊天滥用检测和审计记录。
SECURITY_ENABLED=true
SECURITY_AUDIT_ENABLED=true
SECURITY_MAX_JSON_BODY_BYTES=65536
SECURITY_GENERAL_WINDOW_SECONDS=60
SECURITY_GENERAL_MAX_REQUESTS=120
SECURITY_SMS_WINDOW_SECONDS=3600
SECURITY_SMS_IP_MAX_REQUESTS=10
SECURITY_SMS_MOBILE_MAX_REQUESTS=5
SECURITY_LOGIN_WINDOW_SECONDS=3600
SECURITY_LOGIN_MOBILE_MAX_FAILURES=8
SECURITY_CHAT_WINDOW_SECONDS=60
SECURITY_CHAT_USER_MAX_REQUESTS=20
SECURITY_AI_WINDOW_SECONDS=86400
SECURITY_AI_USER_MAX_REQUESTS=30
SECURITY_CHAT_MAX_CONTENT_CHARS=2000
